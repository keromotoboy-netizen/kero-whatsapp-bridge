PORT=3000
API_SECRET=
DATA_DIR=./data/auth

# 0 = sem corte artificial por quantidade; use um valor >0 apenas se precisar limitar retenção local.
CRM_MAX_MESSAGES_PER_CHAT=0

# FREE-MAX por padrão: regras determinísticas seguras, sem custo e sem envio automático.
AI_PROVIDER=rules
AI_OLLAMA_URL=
AI_MODEL=llama3.2:3b
AI_AUTOMATIC_ALLOWED=0
